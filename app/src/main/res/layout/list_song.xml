<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/spotify_black"
    android:padding="16dp">

    <!-- Header Spotify Style -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Spotify"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:textColor="@color/spotify_green" />

        <Button
            android:id="@+id/btnFavorites"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="💚 Yêu thích"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/spotify_text_primary"
            android:background="@drawable/button_secondary"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </RelativeLayout>

    <!-- Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/search_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="14sp"
            android:textColor="@color/spotify_text_secondary"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/edtSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Bạn muốn nghe gì? (Bài hát, nghệ sĩ...)"
            android:textColorHint="@color/spotify_text_secondary"
            android:textColor="@color/spotify_text_primary"
            android:textSize="14sp"
            android:background="@android:color/transparent"
            android:imeOptions="actionSearch"
            android:inputType="text" />
    </LinearLayout>

    <!-- Quick Action / Add Song -->
    <Button
        android:id="@+id/btnAdd"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="+ Thêm bài hát vào thư viện"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/spotify_black"
        android:background="@drawable/button_primary"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bài hát đã lưu"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/spotify_text_primary"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Không tìm thấy bài hát nào trong thư viện"
        android:textColor="@color/spotify_text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="32dp" />

    <ListView
        android:id="@+id/lvsongs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"
        android:scrollbars="none" />
</LinearLayout>
