<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/miniPlayerRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mini_player_height"
    android:layout_marginStart="@dimen/spacing_small"
    android:layout_marginEnd="@dimen/spacing_small"
    android:layout_marginBottom="@dimen/spacing_xs"
    android:background="@drawable/bg_mini_player"
    android:clickable="true"
    android:elevation="8dp"
    android:focusable="true">

    <!-- Cover Art -->
    <ImageView
        android:id="@+id/ivMiniCover"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/spacing_small"
        android:scaleType="centerCrop"
        android:src="@drawable/playinglogo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <!-- Title and Artist Container -->
    <LinearLayout
        android:id="@+id/layoutMiniInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/spacing_small"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnMiniLike"
        app:layout_constraintStart_toEndOf="@+id/ivMiniCover"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvMiniTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="Chưa phát bài nào"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMiniArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Chọn bài hát để bắt đầu"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption" />
    </LinearLayout>

    <!-- Like Button -->
    <ImageButton
        android:id="@+id/btnMiniLike"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Thích bài hát"
        android:src="@drawable/ic_heart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnMiniPlayPause"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Play/Pause Button -->
    <ImageButton
        android:id="@+id/btnMiniPlayPause"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Phát hoặc tạm dừng"
        android:src="@drawable/ic_play"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnMiniNext"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Next Button -->
    <ImageButton
        android:id="@+id/btnMiniNext"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Bài tiếp theo"
        android:src="@drawable/ic_skip_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Thin Progress Bar at Bottom -->
    <ProgressBar
        android:id="@+id/pbMiniProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="1000"
        android:progress="0"
        android:progressTint="@color/brand_primary"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
