<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mini_player"
    android:orientation="vertical"
    android:padding="@dimen/spacing_xlarge">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tạo Playlist Mới"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_headline"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtPlaylistName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/spacing_large"
        android:background="@drawable/bg_search_box"
        android:hint="Tên danh sách phát"
        android:inputType="textCapWords"
        android:maxLines="1"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_medium"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="@dimen/text_size_body" />

    <EditText
        android:id="@+id/edtPlaylistDesc"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/spacing_medium"
        android:background="@drawable/bg_search_box"
        android:hint="Mô tả (tùy chọn)"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_medium"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="@dimen/text_size_body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xlarge"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogCancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:text="Hủy"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btnDialogCreate"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/spacing_medium"
            android:background="@drawable/button_primary"
            android:text="Tạo"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
